[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"

# A standalone app: never join an enclosing Cargo workspace (e.g. when created inside one).
[workspace]

[dependencies]
gpui-kit = { version = "=0.9.1", features = ["component", "assets", "gpui-fast"] }
# gpui-kit 0.9.1 requires the pre-0.1.16 IntoElement API.
gpui-fast = "=0.1.15"
guiraffe-core = { path = {{core}} }
guiraffe-components = { path = {{components}} }
guiraffe-motion = { path = {{motion}} }
guiraffe-state = { path = {{state}} }
guiraffe-router = { path = {{router}} }
guiraffe-windows = { path = {{windows}} }
guiraffe-overlays = { path = {{overlays}} }
guiraffe-icons = { path = {{icons}} }

# Interactive graphics need optimized dependencies even in dev builds.
[profile.dev.package."*"]
opt-level = 2

# The vendored GPUI / GPUI Kit / Mermaid patches GUIraffe is built and tested with
# (vendor/README.md in the checkout). A standalone workspace does not inherit the GUIraffe
# workspace's [patch] table, so the app repeats it; the paths point into the same checkout
# as the guiraffe-* path dependencies above. Keep this list in sync with the root Cargo.toml
# (the CLI's scaffold tests check it).
[patch.crates-io]
gpui-fast = { path = {{vendor:gpui-fast}} }
gpui-fast-linux = { path = {{vendor:gpui-fast-linux}} }
gpui-pre = { path = {{vendor:gpui-pre}} }
gpui-base = { path = {{vendor:gpui-base}} }
gpui-component = { path = {{vendor:gpui-component}} }
mermaid-rs-renderer = { path = {{vendor:mermaid-rs-renderer}} }
