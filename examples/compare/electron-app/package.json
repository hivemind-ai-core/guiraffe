{
  "name": "compare-electron-app",
  "private": true,
  "version": "0.1.0",
  "description": "GUIraffe vs Electron comparison app (Electron side)",
  "main": "out/main/main.cjs",
  "type": "module",
  "scripts": {
    "build": "vite build && node build-main.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "package": "pnpm build && electron-builder --dir",
    "postinstall": "install-electron"
  },
  "build": {
    "appId": "dev.guiraffe.compare.electron",
    "productName": "compare-electron",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": "dir"
    }
  },
  "dependencies": {
    "@mantine/core": "^9.8.1",
    "@mantine/form": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@mantine/spotlight": "^9.8.1",
    "@shikijs/rehype": "^4.6.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
